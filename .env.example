# HTTP server
PORT=3000
NODE_ENV=development

# Production persistence (required on Render)
DATABASE_URL=postgresql://larose:larose@localhost:5432/larose_files
# The bundled local Docker database has no TLS. Leave this unset on Render.
PGSSLMODE=disable

# Local fallback persistence, used only when DATABASE_URL is blank
DATA_PATH=.data/larose.json

# Set to a long random value in production. Existing player tokens are hashed
# before storage; rotating this value invalidates active sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Render terminates TLS at its proxy.
TRUST_PROXY=1

# Uploaded avatar limit (the server also verifies the MIME signature).
UPLOAD_MAX_MB=2

# Optional persistent avatar directory. Render sets this to its attached disk.
UPLOAD_DIR=.data/uploads
